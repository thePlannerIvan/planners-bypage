{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planners Bypage Source Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_root", "sources"],
  "properties": {
    "contract_version": {"const": "source-index/1.1.0"},
    "source_root": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "file_path", "sha256", "kind", "read_mode", "coverage", "purpose"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src-[a-z0-9][a-z0-9-]{1,63}$"},
          "file_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "kind": {"type": "string", "minLength": 1},
          "read_mode": {"enum": ["full", "sampled", "duplicate_or_derived", "unread"]},
          "coverage": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "locators": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "impact_if_incomplete": {"type": "string"},
          "audit_companion": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["file_path", "sha256", "source_sha256", "extraction_method"],
            "properties": {
              "file_path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "extraction_method": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
