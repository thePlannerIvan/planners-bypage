{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planners Bypage Page Material Packs",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "architecture_sha256", "packs"],
  "properties": {
    "contract_version": {"const": "page-material-packs/1.0.0"},
    "architecture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "page_job", "materials", "asset_ids", "content_development", "gaps"],
        "properties": {
          "page_number": {"type": "integer", "minimum": 1},
          "page_job": {"type": "string", "minLength": 1},
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "locator", "excerpt", "relationship", "used_in"],
              "properties": {
                "source_id": {"type": "string"},
                "locator": {"type": "string", "minLength": 1},
                "excerpt": {"type": "string", "minLength": 1},
                "relationship": {"enum": ["supports", "challenges", "context", "calculation"]},
                "used_in": {"type": "string", "minLength": 1},
                "caveat": {"type": "string"}
              }
            }
          },
          "asset_ids": {"type": "array", "items": {"type": "string"}},
          "content_development": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
