{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planners Bypage Page Architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "project_id", "storyline_thesis", "sections", "pages"],
  "properties": {
    "contract_version": {"const": "page-architecture/1.0.0"},
    "project_id": {"type": "string", "pattern": "^pj_[a-f0-9]{24}$"},
    "storyline_thesis": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "title", "audience_shift", "transition"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^sec-[a-z0-9][a-z0-9-]{1,47}$"},
          "title": {"type": "string", "minLength": 1},
          "audience_shift": {"type": "string", "minLength": 1},
          "transition": {"type": "string"}
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "section_id", "page_type", "page_job", "title_intent", "main_message", "content_blocks", "source_needs", "recommended_assets", "other_candidate_assets", "transition"],
        "properties": {
          "page_number": {"type": "integer", "minimum": 1},
          "section_id": {"type": "string"},
          "page_type": {"enum": ["cover", "contents", "chapter", "claim", "explanation", "data", "case", "process", "diagram", "quote", "summary", "action", "appendix", "freeform"]},
          "page_job": {"type": "string", "minLength": 1},
          "title_intent": {"type": "string", "minLength": 1},
          "main_message": {"type": "string", "minLength": 1},
          "content_blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["block_title", "role", "content_requirement"],
              "properties": {
                "block_title": {"type": "string", "minLength": 1},
                "role": {"type": "string", "minLength": 1},
                "content_requirement": {"type": "string", "minLength": 1},
                "suggested_form": {"enum": ["paragraph", "list", "table", "chart", "image", "comparison", "matrix", "model", "roadmap", "timeline", "case", "freeform"]}
              }
            }
          },
          "source_needs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "recommended_assets": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/assetUse"}},
          "other_candidate_assets": {"type": "array", "items": {"$ref": "#/$defs/assetUse"}},
          "transition": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "assetUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "role", "reason"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset-[a-z0-9][a-z0-9-]{1,63}$"},
        "role": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
